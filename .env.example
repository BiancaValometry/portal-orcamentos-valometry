# Token de API pessoal do ClickUp (Configurações > Apps > API Token).
# NUNCA cole o valor real aqui neste arquivo nem em nenhum commit do repositório.
# Configure o valor real diretamente no painel de Environment Variables do projeto na Vercel.
CLICKUP_API_TOKEN=

# Chave de API da Anthropic (console.anthropic.com > API Keys), usada para a IA
# interpretar o texto livre do solicitante. Mesma regra: nunca cole o valor aqui,
# configure direto no painel de Environment Variables do projeto na Vercel.
ANTHROPIC_API_KEY=
